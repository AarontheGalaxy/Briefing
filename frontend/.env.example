# Backend API URL — copy this file to .env and adjust for your environment
# Leave empty when served behind the nginx proxy (same origin)
VITE_API_URL=http://localhost:8000

# Clerk publishable key (pk_test_... / pk_live_...) — public, not a secret.
# Empty = no-auth single-user local mode (backend CLERK_ISSUER must also be unset)
VITE_CLERK_PUBLISHABLE_KEY=
