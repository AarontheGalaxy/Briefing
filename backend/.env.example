# LLM Provider Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
DEFAULT_PROVIDER=ollama
# Set to false in production — users must bring their own OpenAI/Anthropic key
ENABLE_OLLAMA=true

# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_URL=sqlite+aiosqlite:///./meetings.db

# File upload limit (MB)
MAX_FILE_SIZE_MB=50

# Allowed CORS origins (comma-separated) — only needed for split-origin dev
CORS_ORIGINS=http://localhost:5173

# Clerk authentication — REQUIRED in production.
# Your instance issuer, e.g. https://your-slug.clerk.accounts.dev
CLERK_ISSUER=
# Fail-closed: without CLERK_ISSUER the app refuses to start unless you
# deliberately opt into no-auth single-user mode (local dev only!)
ALLOW_INSECURE_NO_AUTH=false
